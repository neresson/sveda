{
  "name": "sveda",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && pnpm --dir apps/runtime test",
    "test:e2e": "pnpm --dir e2e test:e2e",
    "lint": "eslint . && pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
