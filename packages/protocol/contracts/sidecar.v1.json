{
  "version": "1.0",
  "prefix": "/veda",
  "accept": {
    "vedaStream": "application/vnd.veda.stream+json",
    "sse": "text/event-stream"
  },
  "headers": {
    "inbound": [
      "Accept",
      "Authorization",
      "Content-Type",
      "X-Veda-Admin-Key",
      "X-Veda-Embed-Token",
      "X-Veda-Host-Key",
      "X-Veda-Protocol"
    ],
    "streamResponse": {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache",
      "X-Accel-Buffering": "no",
      "X-Veda-Protocol-Version": "1.0"
    },
    "mcpOutbound": [
      "X-Veda-Page-Context",
      "X-Veda-Chat-Id"
    ]
  },
  "cors": {
    "allowedHeaders": [
      "Accept",
      "Authorization",
      "Content-Type",
      "X-Requested-With",
      "X-Veda-Embed-Token",
      "X-Veda-Host-Key",
      "X-Veda-Admin-Key",
      "X-Veda-Protocol"
    ],
    "allowedMethods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
  },
  "routes": [
    { "method": "POST", "path": "/veda/stream", "mode": "sse" },
    { "method": "POST", "path": "/veda/message", "mode": "json" },
    { "method": "GET", "path": "/veda/chat-histories", "mode": "json" },
    { "method": "GET", "path": "/veda/chat-histories/{chatId}", "mode": "json" },
    { "method": "PATCH", "path": "/veda/chat-histories/{chatId}", "mode": "json" },
    { "method": "DELETE", "path": "/veda/chat-histories/{chatId}", "mode": "json" },
    { "method": "POST", "path": "/veda/documents/extract", "mode": "json" },
    { "method": "GET", "path": "/veda/embed/config", "mode": "json" },
    { "method": "POST", "path": "/veda/embed/token", "mode": "json" }
  ],
  "streamEvents": [
    "message.start",
    "text.delta",
    "reasoning.delta",
    "tool.call",
    "tool.result",
    "tool.progress",
    "context.usage",
    "chat.title",
    "max_steps",
    "message.end",
    "error"
  ],
  "sseDoneLine": "data: [DONE]",
  "embedToken": {
    "request": ["visitor_id", "host_mcp_url", "host_mcp_token"],
    "responseRequired": ["token", "visitor_id", "expires_in"],
    "responseOptional": ["appearance"]
  },
  "message": {
    "responseRequired": ["explanation", "tokens_used", "chat_id"]
  },
  "histories": {
    "listKey": "histories",
    "detailKey": "history",
    "summaryRequired": ["id", "chatId", "title", "preview", "tokensUsed", "version", "createdAt", "updatedAt"],
    "detailRequired": ["id", "chatId", "title", "messages", "conversationHistory", "tokensUsed", "version", "createdAt", "updatedAt"],
    "patchRequest": ["title"],
    "mutationResponseRequired": ["success"]
  },
  "documentsExtract": {
    "requestField": "files",
    "responseKey": "items",
    "itemRequired": ["filename", "ok"]
  }
}
