{
  "name": "@sveda-ai/protocol",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Sveda Wire Protocol — stream event schemas and constants.",
  "keywords": ["sveda", "ai", "agent", "protocol", "sse"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://sveda.dev/docs/stream",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schemas/*": "./schemas/*",
    "./contracts/*": "./contracts/*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schemas/*": "./schemas/*",
      "./contracts/*": "./contracts/*"
    }
  },
  "files": ["dist", "src", "schemas", "contracts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  }
}
