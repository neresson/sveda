{
  "name": "@sveda-ai/solid",
  "version": "0.3.3",
  "type": "module",
  "license": "Apache-2.0",
  "description": "SolidJS chat UI to embed a Sveda AI agent. https://sveda.dev/docs/chat-ui/solid",
  "keywords": [
    "sveda",
    "ai",
    "agent",
    "copilot",
    "solid",
    "solidjs",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/solid"
  },
  "homepage": "https://sveda.dev/docs/chat-ui/solid",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./theme.css": "./src/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && pnpm build:css",
    "build:css": "tailwindcss -c tailwind.config.ts -i src/styles.css -o dist/styles.css --minify && node scripts/append-chat-css.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@sveda-ai/chat": "workspace:*",
    "@sveda-ai/core": "workspace:*",
    "@sveda-ai/protocol": "workspace:*",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lucide-solid": "^0.468.0",
    "marked": "^17.0.2",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "happy-dom": "^20.14.5",
    "solid-js": "^1.9.5",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.1.4"
  }
}
