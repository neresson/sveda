{
  "name": "@sveda-ai/svelte",
  "version": "0.3.2",
  "type": "module",
  "license": "SSPL-1.0",
  "description": "Svelte 5 chat UI to embed a Sveda AI agent. https://sveda.dev/docs/chat-ui/svelte",
  "keywords": [
    "sveda",
    "ai",
    "agent",
    "copilot",
    "svelte",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://sveda.dev/docs/chat-ui/svelte",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./theme.css": "./src/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && npm run build:css && npm run build:types",
    "build:css": "tailwindcss -c tailwind.config.ts -i src/styles.css -o dist/styles.css --minify",
    "build:types": "cp types-entry.d.ts dist/index.d.ts",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@sveda-ai/chat": "workspace:*",
    "@sveda-ai/core": "workspace:*",
    "@sveda-ai/protocol": "workspace:*",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^0.468.0",
    "marked": "^17.0.2",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.2.7",
    "happy-dom": "^20.14.5",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
