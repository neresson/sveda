{
  "name": "@sveda-ai/core",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Framework-agnostic Sveda JS client — streaming, tools, and session.send.",
  "keywords": ["sveda", "ai", "agent", "copilot", "mcp", "client"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/core"
  },
  "homepage": "https://sveda.dev/docs/client",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@sveda-ai/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  }
}
