{
  "name": "@sveda-ai/react",
  "version": "0.3.2",
  "type": "module",
  "license": "SSPL-1.0",
  "description": "React chat UI to embed a Sveda AI agent. https://sveda.dev/docs/chat-ui/react",
  "keywords": [
    "sveda",
    "ai",
    "agent",
    "copilot",
    "react",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/react"
  },
  "homepage": "https://sveda.dev/docs/chat-ui/react",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/theme.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./theme.css": "./src/theme.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly && pnpm build:css",
    "build:css": "tailwindcss -c tailwind.config.ts -i src/styles.css -o dist/styles.css --minify",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@sveda-ai/chat": "workspace:*",
    "@sveda-ai/core": "workspace:*",
    "@sveda-ai/protocol": "workspace:*",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.2",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.4"
  }
}
