{
  "name": "@sveda-ai/chat",
  "version": "0.3.2",
  "type": "module",
  "license": "SSPL-1.0",
  "description": "Framework-agnostic chat store, streaming, helpers, and appearance for Sveda AI. https://sveda.dev/docs/chat-ui",
  "keywords": [
    "sveda",
    "ai",
    "agent",
    "copilot",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neresson/sveda.git",
    "directory": "packages/chat"
  },
  "homepage": "https://sveda.dev/docs/chat-ui",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint configured'"
  },
  "dependencies": {
    "@sveda-ai/core": "workspace:*",
    "@sveda-ai/protocol": "workspace:*",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.2"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  }
}
