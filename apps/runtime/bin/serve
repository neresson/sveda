#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
RUNTIME="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -f "$RUNTIME/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$RUNTIME/.env"
  set +a
fi
export SVEDA_BIND="${SVEDA_BIND:-127.0.0.1:8787}"
export SVEDA_APP_KEY="${SVEDA_APP_KEY:-${APP_KEY:-}}"
export SVEDA_EMBED_ENABLED="${SVEDA_EMBED_ENABLED:-true}"
export SVEDA_ADMIN_DIST="${SVEDA_ADMIN_DIST:-$RUNTIME/public/build}"
cd "$ROOT"
exec cargo run -p sveda-server
