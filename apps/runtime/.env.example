SVEDA_BIND=127.0.0.1:8787
SVEDA_APP_KEY=
SVEDA_EMBED_ENABLED=true
SVEDA_EMBED_HOST_API_KEY=
SVEDA_ADMIN_API_KEY=
SVEDA_CORS_ORIGINS=http://localhost:8001
SVEDA_ADMIN_DIST=
SVEDA_DATABASE_URL=postgres://sveda:sveda@127.0.0.1:5433/sveda
SVEDA_REDIS_URL=redis://127.0.0.1:6380

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Optional seed for Admin → Models → Embeddings (also set there with your own key).
# SVEDA_EMBEDDING_MODEL=text-embedding-3-small
# SVEDA_EMBEDDING_DIMENSIONS=1536
# SVEDA_EMBEDDING_URL=https://api.openai.com/v1
SVEDA_CODE_INDEX_ALLOW_LOCAL_PATHS=true

# Optional Security seeds (admin /admin/security after first boot). 0 / empty = off.
# SVEDA_EMBED_TOKEN_THROTTLE=30,1
# SVEDA_STREAM_THROTTLE=
# SVEDA_OCCUPANCY_GLOBAL=0
# SVEDA_OCCUPANCY_PER_VISITOR=0
# SVEDA_CLIENT_IP_HEADER=
# SVEDA_IP_THROTTLE=

# Public embed internet tools (also Admin → Runtime).
# SVEDA_WEB_ENABLED=true
# SVEDA_SEARXNG_URL=
