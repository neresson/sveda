APP_NAME=Veda
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8787
APP_PORT=8787

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VEDA_MIDDLEWARE=api
VEDA_EMBED_ENABLED=true
VEDA_EMBED_HOST_API_KEY=
VEDA_ADMIN_API_KEY=
VEDA_CORS_ORIGINS=http://localhost:8001
VEDA_PROVIDER=veda-deepseek
VEDA_FAILOVER=veda-deepseek,veda-openai
VEDA_STREAM_PROTOCOL=veda
VEDA_BROADCASTING_ENABLED=false

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
VEDA_YANDEX_API_KEY=
VEDA_YANDEX_FOLDER_ID=
VEDA_YANDEX_CHAT_ENDPOINT=
VEDA_YANDEX_TEXT_MODEL=
VEDA_YANDEX_USE_IAM_BEARER=false
VEDA_YANDEX_EMBEDDING_MODEL_URI=
VEDA_YANDEX_EMBEDDING_QUERY_MODEL_URI=
VEDA_CODE_INDEX_ALLOW_LOCAL_PATHS=true
VEDA_CODE_INDEX_QUEUE=default
