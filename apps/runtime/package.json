{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run build:embed",
        "build:embed": "rm -rf public/build/sveda && mkdir -p public/build/sveda && cp resources/embed/widget.js public/build/sveda/widget.js && vite build --config vite.embed.config.js && pnpm --dir ../../packages/element run build",
        "build:element": "pnpm --dir ../../packages/element run build",
        "dev": "vite",
        "serve": "bash bin/serve"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.3.1",
        "highlight.js": "^11.11.1",
        "lucide-vue-next": "^0.468.0",
        "marked": "^17.0.2",
        "reka-ui": "^2.8.0",
        "tailwind-merge": "^2.6.0",
        "vue": "^3.5.42",
        "vue-i18n": "^11.4.10"
    }
}
