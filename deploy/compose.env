# Copy to .env next to compose.yaml (docker compose loads it automatically).
# curl -fsSL https://raw.githubusercontent.com/neresson/sveda/main/deploy/compose.env -o .env

# Production: pin an immutable tag from GHCR (e.g. sha-522804e). Omit to use latest.
# SVEDA_IMAGE_TAG=sha-522804e

SVEDA_APP_KEY=dev-app-key-change-me
SVEDA_ADMIN_API_KEY=dev-admin-key-change-me
SVEDA_EMBED_HOST_API_KEY=dev-host-key-change-me
SVEDA_CORS_ORIGINS=http://127.0.0.1:8000
DEEPSEEK_API_KEY=

# Optional seeds. 0 / empty = off. The same fields can live in sveda.yaml (SVEDA_CONFIG).
# SVEDA_EMBED_TOKEN_THROTTLE=30,1
# SVEDA_STREAM_THROTTLE=20,1
# SVEDA_OCCUPANCY_GLOBAL=8
# SVEDA_OCCUPANCY_PER_VISITOR=1
# SVEDA_CLIENT_IP_HEADER=CF-Connecting-IP
# SVEDA_IP_THROTTLE=60,1

# Public embed internet tools. Override in sveda.yaml under web.enabled / web.searxng_url.
# SVEDA_WEB_ENABLED=true
# SVEDA_SEARXNG_URL=

# Host app (not read by compose — set on your application):
# SVEDA_CLIENT_BASE_URL=http://127.0.0.1:8787
# SVEDA_CLIENT_HOST_API_KEY=dev-host-key-change-me
