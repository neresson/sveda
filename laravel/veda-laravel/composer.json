{
    "name": "veda-ai/laravel",
    "description": "Veda AI Laravel runtime — embeddable AI copilot: agent, LLM providers, Tool/Context API, conversation storage, streaming.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "ai", "chat", "copilot", "agent", "llm"],
    "require": {
        "php": "^8.4",
        "laravel/ai": "^0.9",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Veda\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Veda\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Veda\\Laravel\\VedaServiceProvider"
            ],
            "aliases": {
                "Veda": "Veda\\Laravel\\Facades\\Veda"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
